# Server
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/setu_works
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/setu_works
MONGO_URI=mongodb://127.0.0.1:27017/setu_works

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed client origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
